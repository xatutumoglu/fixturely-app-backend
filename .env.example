# Fixturely Backend — Environment Variable Template
#
# Copy this file to `.env` for local docker-compose usage and fill in real values.
# Never commit a `.env` file containing real secrets to source control.

# --- SQL Server ---
FIXTURELY_SQL_SA_PASSWORD=Fixturely_Dev_2024!
FIXTURELY_CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost,1433;Database=FixturelyDb;User Id=sa;Password=Fixturely_Dev_2024!;TrustServerCertificate=True;

# --- Redis ---
FIXTURELY_REDIS__CONNECTIONSTRING=localhost:6379

# --- JWT ---
FIXTURELY_JWT__ISSUER=Fixturely
FIXTURELY_JWT__AUDIENCE=FixturelyClient
FIXTURELY_JWT__SIGNINGKEY=please-change-this-signing-key-in-every-environment-32chars-min
FIXTURELY_JWT__ACCESSTOKENMINUTES=15
FIXTURELY_JWT__REFRESHTOKENDAYS=7

# --- Session ---
FIXTURELY_SESSION__IDLETIMEOUTMINUTES=15

# --- Frontend (used to build email links and configure CORS) ---
FIXTURELY_FRONTEND__BASEURL=http://localhost:5173

# --- SMTP ---
# Local development: point these at the Mailpit container (see docker-compose.yml).
# Production: point these at Brevo SMTP (smtp-relay.brevo.com:587) with real credentials.
FIXTURELY_SMTP__HOST=localhost
FIXTURELY_SMTP__PORT=1025
FIXTURELY_SMTP__USERNAME=
FIXTURELY_SMTP__PASSWORD=
FIXTURELY_SMTP__FROMEMAIL=no-reply@fixturely.local
FIXTURELY_SMTP__FROMNAME=Fixturely
FIXTURELY_SMTP__USESSL=false
